{
  "manifest_version": 3,
  "name": "FMHY Similar",
  "version": "1.0.0",
  "description": "Find similar resources on the FMHY wiki. Adds subtle indicators, favorites and an instant Find Similar card — all offline.",
  "homepage_url": "https://fmhy.net/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FMHY Similar",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "core/namespace.js",
      "core/browser.js",
      "core/text.js",
      "core/url-validator.js",
      "database/schema.js",
      "database/codec.js",
      "core/storage.js",
      "core/favorites.js",
      "core/search.js",
      "core/similarity.js",
      "database/sources.js",
      "database/fmhy-parser.js",
      "database/database.js",
      "background/background.js"
    ]
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://fmhy.net/*",
    "https://raw.githubusercontent.com/fmhy/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://fmhy.net/*"
      ],
      "js": [
        "core/namespace.js",
        "core/browser.js",
        "core/text.js",
        "core/url-validator.js",
        "core/storage.js",
        "content/detector.js",
        "content/indicators.js",
        "content/similar-popup.js",
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "database/resources.json"
      ],
      "matches": [
        "https://fmhy.net/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fmhy-similar@fmhy.community",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
